{
  "max_pagination_pages": 2,
  "max_load_more_clicks": 1,
  "max_year_options": 2,
  "max_depth": 12,
  "max_pages_per_website": 3000,
  "page_timeout_seconds": 30,
  "delay_between_pages_seconds": 0.35,
  "max_retries": 2,
  "max_runtime_minutes": 170,
  "crawl_subdomains": true,
  "stabilization_seconds": 0.6,
  "restrict_to_seed_language": true,
  "export_checkpoint_pages": 25,
  "block_heavy_resources": true,
  "document_head_timeout_seconds": 4,
  "keep_meaningful_query_parameters": [
    "year",
    "page",
    "category",
    "type",
    "section"
  ],
  "remove_query_parameters": [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "fbclid",
    "gclid"
  ],
  "allowed_hosts": []
}
