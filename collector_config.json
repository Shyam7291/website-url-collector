{
  "max_pagination_pages": 2,
  "max_load_more_clicks": 1,
  "max_year_options": 4,
  "max_depth": 12,
  "max_pages_per_website": 3000,
  "max_documents_per_page": 50,
  "max_esg_navigation_clicks_per_page": 8,

  "page_timeout_seconds": 30,
  "page_attempt_timeout_seconds": 75,
  "page_close_timeout_seconds": 5,
  "document_head_timeout_seconds": 4,
  "stabilization_seconds": 0.25,
  "delay_between_pages_seconds": 0.15,
  "max_retries": 2,
  "max_runtime_minutes": 170,

  "crawl_subdomains": true,
  "restrict_to_seed_language": true,
  "allowed_hosts": [],

  "max_new_children_per_page": 40,
  "max_homepage_children": 100,
  "max_pages_per_url_family": 25,
  "max_query_variants_per_path": 3,
  "follow_same_family_links_from_detail_pages": false,
  "prioritize_document_likely_pages": true,

  "query_parameter_mode": "whitelist",
  "keep_meaningful_query_parameters": [
    "year",
    "page",
    "paged",
    "p",
    "offset",
    "start",
    "category",
    "cat",
    "type",
    "section",
    "topic",
    "tag",
    "id",
    "doc",
    "document",
    "file",
    "lang",
    "locale",
    "sort",
    "view",
    "q"
  ],
  "remove_query_parameters": [
    "utm_source",
    "utm_medium",
    "utm_campaign",
    "utm_term",
    "utm_content",
    "fbclid",
    "gclid",
    "msclkid",
    "mc_cid",
    "mc_eid",
    "ref",
    "referrer",
    "_ga"
  ],

  "respect_robots_txt": true,
  "use_sitemap": true,
  "max_sitemaps": 25,
  "max_sitemap_urls": 5000,

  "concurrency": 4,
  "block_heavy_resources": true,
  "export_checkpoint_pages": 25,
  "recover_orphaned_pages": true,

  "user_agent": "Mozilla/5.0 (compatible; WebsiteURLCollector/2.0)",
  "robots_agent": "websiteurlcollector"
}
